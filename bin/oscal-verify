#!/usr/bin/env python3
"""oscal-verify FILE [--receipts DIR]

Recomputes the hash chain and head hash of a receipts-to-oscal document. With --receipts it also
rehashes each receipt file the observations name.
Exit: 0 intact; 1 any tamper, mismatch or unparseable document; 2 usage or unreadable file.
Integrity only: a forger who recomputes every hash passes. Anchor the chain-head elsewhere.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import chain  # noqa: E402


def main(argv):
    ap = argparse.ArgumentParser(prog="oscal-verify")
    ap.add_argument("file")
    ap.add_argument("--receipts", help="directory holding the original receipt files")
    a = ap.parse_args(argv)
    try:
        with open(a.file, "rb") as fh:
            raw = fh.read()
    except OSError as exc:
        print("oscal-verify: cannot read %s: %s" % (a.file, exc.strerror), file=sys.stderr)
        return 2
    try:
        doc = json.loads(raw.decode("utf-8"))
    except ValueError:
        print("TAMPER document is not valid JSON")
        print("oscal-verify: FAIL")
        return 1
    ok, total, problems = chain.verify(doc, a.receipts)
    print("chain: %d/%d links verify" % (ok, total))
    for p in problems:
        print(p)
    if problems:
        print("oscal-verify: FAIL")
        return 1
    print("head: ok")
    print("oscal-verify: intact")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
